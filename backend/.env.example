# ============================
# N+ONE AI Copilot - Environment
# ============================

# --- App ---
APP_NAME="N+ONE AI Customer Copilot"
APP_ENV=development                 # development | production
DEBUG=true
API_PREFIX=/api/v1

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=20042004            # generated with utils/security.hash_password()
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=https://nplusone.africa,http://localhost:5500,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_ADMIN=60/minute

# --- Database ---
# SQLite by default; swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/npone_copilot
DATABASE_URL=sqlite:///./database/npone_copilot.db

# --- LLM Provider ---
LLM_PROVIDER=ollama                # openai | ollama
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store ---
VECTORSTORE_DIR=./vectorstore/faiss_index
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVER_TOP_K=4

# --- RAG behavior ---
MIN_SIMILARITY_SCORE=0.35
FALLBACK_MESSAGE="I don't have enough verified information to answer that yet. Please contact N+ONE DATACENTERS directly at +212 520 460 110 or via https://nplusone.africa/contact-us/."
